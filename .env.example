# ==============================================================================
# ARGOS AI — Production Environment Configuration Template
# ==============================================================================

# Core Application
PROJECT_NAME="ARGOS AI Forensic & Media Protection Engine"
ENVIRONMENT="development"
DEBUG="true"
DEMO_MODE="false"

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/argos_ai"

# Security & JWT Tokens
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
JWT_SECRET="replace-with-a-cryptographically-secure-jwt-signing-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Session & Cookies
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# Login Rate Limiting & Throttling
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SEC=300

# Redis & Celery Workers
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# SMTP / Email Delivery (Leave empty to trigger clear configuration advisory)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="security@argos.ai"

# Payment Gateways (Razorpay for INR ₹199/mo & Stripe)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_API_KEY=""

# Two-Tier Quotas & Constraints
FREE_ANALYSIS_LIMIT=10
PRO_ANALYSIS_LIMIT=10000
FREE_MAX_VIDEO_DURATION_SEC=60.0
PRO_MAX_VIDEO_DURATION_SEC=600.0

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"
