# ==============================================================================
# ARGOS AI - Production Environment Variables
# Copy to .env and configure credentials for deployment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=false

# Security & Secret Keys (Generate with: openssl rand -hex 32)
SECRET_KEY=argos-sovereign-dev-secret-key-c2pa-2026-unbreak-crypto
JWT_SECRET=argos-jwt-secret-token-sign-sovereign-matrix-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Relational Database (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/argos_ai

# Job Queue Broker & Cache (Redis 7+)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage & Upload Limits
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE=104857600
MODEL_DIR=models

# Inference Engine & Hardware Acceleration (Problem Statement 4)
CUDA_ENABLED=true
FFMPEG_PATH=
ANALYSIS_TIMEOUT=600
WINDOW_SIZE=0.8
WINDOW_STRIDE=0.2
FACE_DETECTION_CONFIDENCE=0.70
FAKE_THRESHOLD=0.55

# Cross-Origin Resource Sharing
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Optional Object Storage (S3 / MinIO)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=argos-media-vault
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
