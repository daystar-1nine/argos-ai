{
  "manifest_version": 3,
  "name": "ARGOS.AI — Deepfake & Media Forensics Scanner",
  "version": "1.0.0",
  "description": "Protect. Detect. Verify. Respond. AI-powered media protection & deepfake detection on YouTube, Instagram, and web videos.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ARGOS.AI Deepfake Forensics"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
